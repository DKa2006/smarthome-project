// ==== Cai dat BLE ====
BLECharacteristic *pBLECharacteristic;
std::string bleStatus = "⏳ Dang cho du lieu tu BLE...";
bool newBLEDataReceived = false;
String bleReceivedData = "";
bool wifiReady = false;

// Lop xu ly du lieu BLE duoc gui den
class BLECallback : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *pCharacteristic) override {
    std::string value = pCharacteristic->getValue();
    if (value.length() > 0) {
      bleReceivedData = String(value.c_str());
      bleReceivedData.trim();
      newBLEDataReceived = true;

      Serial.println("📥 Da nhan qua BLE:");
      Serial.println(bleReceivedData);

      // Tra ve trang thai ket noi
      pCharacteristic->setValue(bleStatus);
      pCharacteristic->notify();
    }
  }

  void onRead(BLECharacteristic *pCharacteristic) override {
    pCharacteristic->setValue(bleStatus);
    Serial.println("📤 BLE Read → gui trang thai: " + String(bleStatus.c_str()));
  }
};

// Ham khoi dong BLE
void setupBLE() {
  BLEDevice::init("Home Home");
  BLEServer *pServer = BLEDevice::createServer();
  BLEService *pService = pServer->createService("12345678-1234-1234-1234-1234567890ab");

  pBLECharacteristic = pService->createCharacteristic(
    "abcdefab-1234-5678-90ab-abcdefabcdef",
    BLECharacteristic::PROPERTY_WRITE |
    BLECharacteristic::PROPERTY_READ |
    BLECharacteristic::PROPERTY_NOTIFY
  );

  pBLECharacteristic->setCallbacks(new BLECallback());
  pService->start();
  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->start();

  Serial.println("🔵 BLE san sang. Gui 'SSID,PASS' tu LightBlue/nRF Connect");
}

// ==== Bien ao tren Blynk ====
#define VIRTUAL_TEMP V0
#define VIRTUAL_HUMID V1
#define VIRTUAL_DOOR V5

// ==== Khai bao chan va thiet bi ====
#define SS_PIN 5
#define RST_PIN 16
#define BUZZER_PIN 12
#define PIN_SG90 27
#define PIN_SG90_2 13
#define RAIN_SENSOR_PIN 34
#define FLAME_SENSOR_PIN 33
#define GAS_SENSOR_PIN 32
#define DHTPIN 14          // Chân nối cảm biến (bạn có thể thay đổi)
#define DHTTYPE DHT11      // Nếu dùng DHT22 thì đổi thành DHT22
DHT dht(DHTPIN, DHTTYPE);

MFRC522 mfrc522(SS_PIN, RST_PIN);
LiquidCrystal_I2C lcd(0x27, 16, 2);
Servo sg90, sg90_2;

byte validUID1[4] = {0x13, 0xA2, 0x1A, 0x2D};
byte validUID2[4] = {0x5A, 0xB2, 0xB5, 0x02};

bool doorOpen = false;
String ssid_input = "";
String password_input = "";

// ==== Ket noi WiFi ====
void setup_wifi() {
  WiFi.begin(ssid_input.c_str(), password_input.c_str());
  Serial.print("📶 Dang ket noi toi WiFi: ");
  Serial.println(ssid_input);
  int retry = 0;
  while (WiFi.status() != WL_CONNECTED && retry < 20) {
    delay(500);
    Serial.print(".");
    retry++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n✅ Da ket noi WiFi!");
    wifiReady = true;
    bleStatus = "✅ Ket noi WiFi thanh cong!";
  } else {
    Serial.println("\n❌ Ket noi WiFi that bai!");
    bleStatus = "❌ Ket noi WiFi that bai!";
  }

  pBLECharacteristic->setValue(bleStatus);
  pBLECharacteristic->notify();
}

// ==== So sanh UID cua the RFID ====
bool compareUID(byte *cardUID, byte *targetUID) {
  for (byte i = 0; i < 4; i++) {
    if (cardUID[i] != targetUID[i]) return false;
  }
  return true;
}

// ==== Ham keu buzzer ====
void beep(int duration) {
  digitalWrite(BUZZER_PIN, HIGH);
  delay(duration);
  digitalWrite(BUZZER_PIN, LOW);
}

void saveDoorState(bool state) { doorOpen = state; }

void restoreDoorState() {
  if (doorOpen) {
    sg90.write(0);
    doorOpen = false;
    Serial.println("🛠 Cua dong lai theo trang thai cu");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Door closed");
  }
}

// ==== Xu ly quet the RFID ====
void checkRFID() {
  if (!mfrc522.PICC_IsNewCardPresent() || !mfrc522.PICC_ReadCardSerial()) {
    lcd.setCursor(0, 0);
    lcd.print("Scan card...     ");
    return;
  }

  Serial.print("UID: ");
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("UID: ");

  for (byte i = 0; i < mfrc522.uid.size; i++) {
    Serial.print(mfrc522.uid.uidByte[i] < 0x10 ? " 0" : " ");
    Serial.print(mfrc522.uid.uidByte[i], HEX);
    lcd.print(mfrc522.uid.uidByte[i], HEX);
    lcd.print(" ");
  }
  Serial.println();

  if (compareUID(mfrc522.uid.uidByte, validUID1) || compareUID(mfrc522.uid.uidByte, validUID2)) {
    // Neu the hop le
    Serial.println("✅ Truy cap hop le");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Access Granted");

    beep(200);
    delay(2000);

    sg90.write(180);         // Mo cua
    saveDoorState(true);
    delay(5000);
    sg90.write(0);           // Dong cua
    saveDoorState(false);

    Serial.println("🔒 Cua da dong");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Door closed");
  } else {
    // The sai
    Serial.println("❌ The khong hop le");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Access Denied");

    beep(500);
  }

  mfrc522.PICC_HaltA();
}

// ==== Doc nhiet do, do am ====
void readSensors() {
  float temperature = dht.readTemperature();   // Doc nhiet do (°C)
  float humidity = dht.readHumidity();         // Doc do am (%)

  if (isnan(temperature) || isnan(humidity)) {
    Serial.println("❌ Loi khi doc cam bien DHT!");
    lcd.setCursor(0, 0);
    lcd.print("DHT Error       ");
    return;
  }

  Serial.print("🌡 Nhiet do: ");
  Serial.println(temperature);
  Serial.print("💧 Do am: ");
  Serial.println(humidity);

  Blynk.virtualWrite(VIRTUAL_TEMP, temperature);
  Blynk.virtualWrite(VIRTUAL_HUMID, humidity);
}


// ==== Ham setup ====
void setup() {
  Serial.begin(115200);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(RAIN_SENSOR_PIN, INPUT);
  pinMode(FLAME_SENSOR_PIN, INPUT);

  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("🔋 Khoi dong...");

  SPI.begin();
  mfrc522.PCD_Init();

  sg90.attach(PIN_SG90, 500, 2400);
  sg90_2.attach(PIN_SG90_2, 500, 2400);
  sg90.write(0);
  sg90_2.write(0);

  setupBLE();

  Serial.println("✅ Da khoi dong xong!");

  dht.begin();
}

// ==== Vong lap chinh ====
void loop() {
  // Neu chua ket noi WiFi va co du lieu BLE moi
  if (!wifiReady && newBLEDataReceived) {
    if (bleReceivedData.indexOf(',') != -1) {
      int splitIndex = bleReceivedData.indexOf(',');
      ssid_input = bleReceivedData.substring(0, splitIndex);
      password_input = bleReceivedData.substring(splitIndex + 1);
      ssid_input.trim();
      password_input.trim();

      Serial.println("📡 Dang ket noi voi:");
      Serial.println("SSID: " + ssid_input);
      Serial.println("PASS: " + password_input);

      setup_wifi();
      if (wifiReady) {
        Blynk.begin(BLYNK_AUTH_TOKEN, ssid_input.c_str(), password_input.c_str());
        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("WiFi OK. Blynk on");
        delay(1000);
        restoreDoorState();
      }
    }
  }

  // Neu da ket noi WiFi
  if (wifiReady) {
    Blynk.run();
    readSensors();
    checkRFID();
  }

  // Xu ly cam bien mua
  int rainState = digitalRead(RAIN_SENSOR_PIN);
  Serial.print("📊 Trang thai cam bien mua (digital): ");
  Serial.println(rainState);

  if (rainState == LOW) {
    Serial.println("🌧 Co mua → servo 2 quay 90 do");
    sg90_2.write(90);
  } else {
    Serial.println("☀️ Khong mua → servo 2 quay ve 0 do");
    sg90_2.write(0);
  }

  handleFireAndGas();  // Xu ly cam bien lua va gas
}

// ==== Xu ly lua va gas ====
bool dangerPreviouslyDetected = false;
void handleFireAndGas() {
  int flameValue = analogRead(FLAME_SENSOR_PIN);
  int gasValue = analogRead(GAS_SENSOR_PIN);

  bool flameDetected = flameValue < 200;
  bool gasDetected = gasValue > 500;

  Serial.print("🔥 Flame: ");
  Serial.print(flameValue);
  Serial.print(" | 🛢 Gas: ");
  Serial.println(gasValue);

  if (flameDetected || gasDetected) {
    if (!dangerPreviouslyDetected) {
      Serial.println("⚠️ Phat hien NGUY HIEM! MO CUA NGAY!");
      lcd.clear();
      lcd.setCursor(0, 0);
      if (flameDetected && gasDetected)
        lcd.print("🔥 GAS & FIRE ⚠️");
      else if (flameDetected)
        lcd.print("🔥 Lua! Mo cua!");
      else
        lcd.print("🛢 Gas! Mo cua!");

      sg90.write(180);               // Mo cua
      digitalWrite(BUZZER_PIN, HIGH); // Bat bao dong
      dangerPreviouslyDetected = true;
    }
  } else {
    if (dangerPreviouslyDetected) {
      Serial.println("✅ Het nguy hiem. DONG CUA.");
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("An toan. Dong cua");

      sg90.write(0);                 // Dong cua
      digitalWrite(BUZZER_PIN, LOW); // Tat bao dong
      dangerPreviouslyDetected = false;
    }
  }
}
